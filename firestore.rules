rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedEmail() &&
        request.auth.token.email in ['walidghazal46@gmail.com', 'walidghazal51@yahoo.com'];
    }

    // ─── orders ─────────────────────────────────────────────────────────────
    // Orders are created via Cloud Function (createOrder) - not directly by clients.
    // Users can read their own orders; admins can read/write all.
    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
        (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if false; // Only Cloud Function can create
      allow update: if isAdmin();
      allow delete: if isAuthenticated() &&
        (resource.data.userUid == request.auth.uid || isAdmin());
    }

    // ─── office_reviews ──────────────────────────────────────────────────────
    // Anyone can read reviews. Authenticated users can create one review.
    // Users can update/delete only their own reviews.
    match /office_reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        (
          (request.resource.data.userUid is string && request.resource.data.userUid == request.auth.uid) ||
          (request.resource.data.reviewerUid is string && request.resource.data.reviewerUid == request.auth.uid)
        ) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update: if isAuthenticated() &&
        (
          (resource.data.userUid is string && resource.data.userUid == request.auth.uid) ||
          (resource.data.reviewerUid is string && resource.data.reviewerUid == request.auth.uid)
        );
      allow delete: if isAuthenticated() &&
        (
          (resource.data.userUid is string && resource.data.userUid == request.auth.uid) ||
          (resource.data.reviewerUid is string && resource.data.reviewerUid == request.auth.uid) ||
          isAdmin()
        );
    }

    // ─── study_abroad_reviews ──────────────────────────────────────────────
    // Anyone can read. Authenticated users can create with their own uid.
    // Users can update/delete their own reviews only after 48 hours.
    // Admin can update/delete at any time.
    match /study_abroad_reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.officeId is string &&
        request.resource.data.officeId.size() > 0 &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.reviewText is string &&
        request.resource.data.reviewText.size() > 0;
      allow update: if isAuthenticated() && (
          isAdmin() ||
          (
            resource.data.userUid == request.auth.uid &&
            resource.data.createdAt is timestamp &&
            request.time >= resource.data.createdAt + duration.value(48, 'h')
          )
        );
      allow delete: if isAuthenticated() && (
          isAdmin() ||
          (
            resource.data.userUid == request.auth.uid &&
            resource.data.createdAt is timestamp &&
            request.time >= resource.data.createdAt + duration.value(48, 'h')
          )
        );
    }

    // ─── office_customizations ──────────────────────────────────────────────
    // Public read. Admin-only write. Doc ID must match override-* or added-* pattern.
    match /office_customizations/{docId} {
      allow read: if true;

      allow create, update: if isAdmin() &&
        (docId.matches('override-[a-zA-Z0-9_-]+') || docId.matches('added-[a-zA-Z0-9_-]+')) &&
        request.resource.data.keys().hasAll(['officeId', 'updatedAt']) &&
        request.resource.data.officeId is string &&
        request.resource.data.officeId.size() > 0 &&
        request.resource.data.officeId.size() <= 100;

      allow delete: if isAdmin();
    }

    // ─── Ads ────────────────────────────────────────────────────────────────
    // Public read so the main banner can be shown to every app user.
    // Admin-only write from Firebase Console or trusted admin tools.
    match /Ads/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── service_providers ──────────────────────────────────────────────────
    // Public read for listings. Authenticated users can submit a request.
    // Users can read/update their own. Admins have full access.
    match /service_providers/{docId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.userUid == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.userUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── service_reviews ────────────────────────────────────────────────────
    // Anyone can read. Authenticated users can create. Own reviews are editable.
    match /service_reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        (
          (request.resource.data.userUid is string && request.resource.data.userUid == request.auth.uid) ||
          (request.resource.data.reviewerUid is string && request.resource.data.reviewerUid == request.auth.uid)
        ) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update: if isAuthenticated() &&
        (
          (resource.data.userUid is string && resource.data.userUid == request.auth.uid) ||
          (resource.data.reviewerUid is string && resource.data.reviewerUid == request.auth.uid)
        );
      allow delete: if isAuthenticated() &&
        (
          (resource.data.userUid is string && resource.data.userUid == request.auth.uid) ||
          (resource.data.reviewerUid is string && resource.data.reviewerUid == request.auth.uid) ||
          isAdmin()
        );
    }

    // ─── studyAbroadOffices ──────────────────────────────────────────────────
    // Public read for the directory listing (the app falls back to bundled
    // seed data on permission-denied, masking this collection's absence of
    // rules — but that means live Firestore updates never reach users).
    // Admin-only write from Firebase Console or trusted admin tools.
    match /studyAbroadOffices/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── admin_notifications ─────────────────────────────────────────────────
    // Public read so every signed-in user sees broadcast notifications.
    // Admin-only write (the in-app "Notification Center").
    match /admin_notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── push_tokens ────────────────────────────────────────────────────────
    // Each signed-in user can register/update their own device token.
    // Admins can inspect/delete tokens for operational cleanup.
    match /push_tokens/{tokenId} {
      allow create, update: if isAuthenticated() &&
        request.resource.data.userUid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // ─── cv_package_stats ────────────────────────────────────────────────────
    // Public read so every visitor can see CV package popularity/ratings.
    // Authenticated users can write because the app updates these aggregate
    // counters (request counts, ratings) whenever a signed-in user requests
    // or rates a CV package (see syncCvPackageStatsInFirebase).
    match /cv_package_stats/{packageKey} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ─── users ───────────────────────────────────────────────────────────────
    // Users can read and update their own profile. Admins can read all.
    // Deletion is only via Cloud Function (deleteAuthUserByAdmin).
    match /users/{userId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() &&
        request.auth.uid == userId;
      allow update: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());
      allow delete: if false; // Only Cloud Function can delete
    }

  }
}
