@@ -1,3 +1,111 @@
+.section-card {
+  transition: transform 0.22s ease, box-shadow 0.22s ease !important;
+}
+.section-card:hover {
+  transform: translateY(-4px) !important;
+  box-shadow: 0 16px 36px rgba(31, 56, 88, 0.15) !important;
+}
+.section-card:active {
+  transform: translateY(-1px) !important;
+}
+
+.cv-pricing-card {
+  transition: transform 0.22s ease, box-shadow 0.25s ease !important;
+  will-change: transform, box-shadow;
+}
+.cv-pricing-card:hover {
+  transform: translateY(-5px) scale(1.012) !important;
+  box-shadow: 0 22px 44px rgba(15, 23, 42, 0.18) !important;
+}
+.cv-pricing-card:active {
+  transform: translateY(-2px) scale(1.006) !important;
+}
+
+.cv-pricing-stats-card {
+  transition: transform 0.2s ease, box-shadow 0.22s ease, filter 0.22s ease;
+  will-change: transform, box-shadow;
+}
+
+.cv-pricing-stats-card:hover {
+  transform: translateY(-3px) scale(1.01);
+  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.12);
+  filter: saturate(1.03);
+}
+
+.cv-pricing-stats-card:active {
+  transform: translateY(-1px) scale(1.005);
+}
+
+.landing-country-card {
+  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease !important;
+}
+
+.inner-country-square {
+  transition: transform 0.18s ease, box-shadow 0.18s ease;
+}
+
+.country-flag-img {
+  transition: transform 0.2s ease, filter 0.2s ease, box-shadow 0.22s ease;
+  will-change: transform, box-shadow;
+}
+
+.landing-country-card:hover .country-flag-img,
+.landing-country-card:focus-visible .country-flag-img {
+  transform: translateY(-2px) scale(1.06);
+  filter: saturate(1.08);
+  box-shadow: 0 0 0 3px rgba(148, 163, 184, 0.2), 0 0 18px 4px rgba(148, 163, 184, 0.24), 0 8px 18px rgba(15, 23, 42, 0.12);
+}
+
+.landing-country-card:active .country-flag-img {
+  transform: translateY(-1px) scale(1.03);
+}
+
+.support-whatsapp-tile {
+  transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease !important;
+}
+
+.support-whatsapp-tile:hover {
+  transform: translateY(-2px) !important;
+  box-shadow: none !important;
+  filter: none;
+}
+
+.support-whatsapp-tile:active {
+  transform: translateY(-1px) !important;
+}
+
+@keyframes shimmer {
+  0% {
+    background-position: -1000px 0;
+  }
+  100% {
+    background-position: 1000px 0;
+  }
+}
+
+.ads-contact-link {
+  transition: all 0.2s ease;
+}
+
+.ads-contact-link:hover {
+  background: linear-gradient(90deg, rgba(34, 197, 94, 0.15) 0%, rgba(74, 222, 128, 0.25) 50%, rgba(34, 197, 94, 0.15) 100%) !important;
+  background-size: 1000px 100% !important;
+  animation: shimmer 1.5s infinite !important;
+}
+
+.job-site-link {
+  transition: transform 0.2s ease;
+}
+
+.job-site-icon {
+  transition: transform 0.2s ease, filter 0.2s ease;
+}
+
+.job-site-link:hover .job-site-icon {
+  transform: scale(1.15) translateY(-2px);
+  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
+}
+
 .counter {
   font-size: 16px;
   padding: 5px 10px;
@@ -196,19 +304,19 @@
